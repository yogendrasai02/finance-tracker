# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# The owner's login credential, applied on startup when the account has no password yet.
# A migration must never carry a password hash, so this is where the first one comes from.
# Minimum 12 characters. Changing it later does not reset an existing password.
FT_OWNER_EMAIL=owner@ft.local
FT_OWNER_PASSWORD=replace-with-a-long-random-password

# Optional.
# docker-compose.yml already defaults these for local development, so set them only to override.
# POSTGRES_DB=financetracker
# POSTGRES_USER=financetracker
# POSTGRES_PASSWORD=
# POSTGRES_PORT=5432
# FT_MIGRATOR_PASSWORD=
# FT_APP_PASSWORD=

# Production only (application-prod.yml). Local development uses the block above instead.
# ProductionEnvironmentGuard refuses to start the prod profile if any of these five are missing or malformed.
# SPRING_PROFILES_ACTIVE=prod
#
# DB_URL must include sslmode=verify-full (SECURITY.md SR-36).
# The Postgres JDBC driver's own default, sslmode=prefer, silently falls back to a plaintext connection if TLS negotiation fails.
# DB_URL=jdbc:postgresql://<host>:5432/financetracker?currentSchema=app&sslmode=verify-full
# DB_APP_USERNAME=ft_app
# DB_APP_PASSWORD=
# DB_MIGRATOR_USERNAME=ft_migrator
# DB_MIGRATOR_PASSWORD=

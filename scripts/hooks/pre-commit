#!/usr/bin/env bash
set -euo pipefail

# Fails closed: blocks the commit if gitleaks isn't installed, rather than skipping the check (SR-46).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed." >&2
  echo "Install it with: brew install gitleaks" >&2
  exit 1
fi

gitleaks protect --staged --redact -v
